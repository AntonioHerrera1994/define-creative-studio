---
// ═══════════════════════════════════════════════
// SEO — meta tags, Open Graph, Twitter, hreflang, canonical y JSON-LD
// Uso: <SEO title="..." description="..." schema={[...]} />  (va dentro de <head>)
// ═══════════════════════════════════════════════
import { SITE } from '../../data/site';
import { getLangFromUrl, getAlternatePath, useTranslations } from '../../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  keywords?: string;
  noindex?: boolean;
  /** Si una página NO tiene versión en el otro idioma, pásalo en false */
  hasAlternate?: boolean;
  /** Fechas para artículos del blog */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Uno o varios objetos Schema.org (se combinan en un @graph) */
  schema?: Record<string, unknown>[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t.meta.title,
  description = t.meta.description,
  image = SITE.ogImage,
  imageAlt = t.meta.ogImageAlt,
  type = 'website',
  keywords,
  noindex = false,
  hasAlternate = true,
  publishedTime,
  modifiedTime,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const esUrl = new URL(getAlternatePath(Astro.url, 'es'), Astro.site);
const enUrl = new URL(getAlternatePath(Astro.url, 'en'), Astro.site);
const imageUrl = new URL(image, Astro.site).href;
const altLocale = lang === 'es' ? 'en_US' : 'es_MX';

const jsonLd = schema.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })
  : null;
---

<!-- ═══ SEO PRIMARIO ═══ -->
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content={SITE.name} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta name="geo.region" content="MX-BCN" />
<meta name="geo.placename" content="Tijuana, Baja California, México" />
<link rel="canonical" href={canonical} />

{hasAlternate && (
  <>
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
  </>
)}

<!-- ═══ OPEN GRAPH ═══ -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={t.meta.ogLocale} />
{hasAlternate && <meta property="og:locale:alternate" content={altLocale} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- ═══ TWITTER CARD ═══ -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- ═══ SCHEMA.ORG JSON-LD ═══ -->
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
