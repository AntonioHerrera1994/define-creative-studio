---
import './service-includes.css';
import type { ServicePage } from '../../../data/services/types';

interface Props { data: ServicePage['includes'] }
const { data } = Astro.props;
---

<section class="s-includes section section--dark">
  <div class="container">
    <header class="section-head">
      <span class="kicker s-includes__kicker">{data.kicker}</span>
      <h2 class="section-title s-includes__title" set:html={data.titleHtml} />
    </header>

    <ul class="s-includes__grid">
      {data.items.map((it) => (
        <li class="s-includes__item" data-reveal>
          <span class="material-symbols-outlined" aria-hidden="true">{it.icon}</span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
