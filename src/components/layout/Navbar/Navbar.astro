---
import './navbar.css';
import { SITE } from '../../../data/site';
import { getLangFromUrl, useTranslations, localizePath, getAlternatePath, waLink } from '../../../i18n/utils';

interface Props { alternateHref?: string }
const { alternateHref } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizePath('/', lang);
const otherLang = lang === 'es' ? 'en' : 'es';
const es = lang === 'es';

type NavLink = { href: string; label: string; external?: boolean };

// Páginas de servicio del dropdown (agrega aquí branding, fotografía… cuando existan)
const serviceItems = [
  {
    href: localizePath('/web-design-san-diego/', lang),
    icon: 'web',
    title: es ? 'Diseño web' : 'Web design',
    text: es ? 'Páginas web bilingües guiadas por tu marca' : 'Brand-driven, bilingual websites',
  },
  {
    href: localizePath('/gohighlevel-san-diego/', lang),
    icon: 'hub',
    title: 'GoHighLevel',
    text: es ? 'CRM y automatización administrados' : 'Managed CRM & automation',
  },
];
const allServices = { href: `${home}#services`, label: es ? 'Ver todos los servicios' : 'View all services' };

// Las anclas apuntan al home para que funcionen también desde el blog
const links: NavLink[] = [
  { href: `${home}#proceso`, label: t.nav.process },
  { href: `${home}#portfolio`, label: t.nav.portfolio },
  { href: `${home}#pricing`, label: t.nav.pricing },
  { href: localizePath('/blog/', lang), label: t.nav.blog },
  { href: SITE.ikariUrl, label: t.nav.ikari, external: true },
];
const ext = (l: NavLink) => (l.external ? { target: '_blank', rel: 'noopener' } : {});
---

<nav class="navbar" aria-label="Principal">
  <div class="navbar__inner container">
    <a class="navbar__logo" href={home}>
      <img src={SITE.logo} alt={SITE.name} width="170" height="48" />
    </a>

    <ul class="navbar__links">
      <!-- Dropdown de servicios -->
      <li class="navbar__dd" data-dropdown>
        <button class="navbar__dd-btn" type="button" aria-expanded="false" aria-controls="services-menu">
          {t.nav.services}
          <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
        </button>
        <div class="navbar__dd-panel" id="services-menu">
          <ul>
            {serviceItems.map((s) => (
              <li>
                <a class="navbar__dd-item" href={s.href}>
                  <span class="navbar__dd-icon material-symbols-outlined" aria-hidden="true">{s.icon}</span>
                  <span>
                    <strong>{s.title}</strong>
                    <small>{s.text}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="navbar__dd-all" href={allServices.href}>
            {allServices.label}
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      </li>

      {links.map((l) => (
        <li><a href={l.href} {...ext(l)}>{l.label}</a></li>
      ))}
    </ul>

    <div class="navbar__actions">
      <a class="navbar__lang" href={alternateHref ?? getAlternatePath(Astro.url, otherLang)} hreflang={otherLang} title={t.nav.switchLabel} aria-label={t.nav.switchLabel}>
        <span aria-hidden="true">{t.nav.switchFlag}</span> <span>{t.nav.switchShort}</span>
      </a>
      <a class="btn btn--accent btn--sm navbar__cta" href={waLink(t.wa.general)} target="_blank" rel="noopener">{t.nav.contact}</a>

      <button class="navbar__burger" id="hamburger-btn" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div class="navbar__mobile" id="mobile-menu" hidden>
    <ul class="container">
      <!-- Servicios como acordeón (details nativo, sin JS) -->
      <li>
        <details class="navbar__mgroup">
          <summary>
            {t.nav.services}
            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
          </summary>
          <ul>
            {serviceItems.map((s) => (
              <li>
                <a href={s.href}>
                  <span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>{s.title}
                </a>
              </li>
            ))}
            <li><a href={allServices.href}>{allServices.label}</a></li>
          </ul>
        </details>
      </li>
      {links.map((l) => (
        <li><a href={l.href} {...ext(l)}>{l.label}</a></li>
      ))}
      <li><a href={waLink(t.wa.general)} target="_blank" rel="noopener">{t.nav.contact}</a></li>
    </ul>
  </div>
</nav>

<script>
  import './navbar.js';
</script>