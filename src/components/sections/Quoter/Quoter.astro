---
import './quoter.css';
import { getLangFromUrl, useTranslations, WA_NUMBER } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const q = t.quoter;

// Datos que necesita quoter.js (planes y textos en el idioma actual)
const data = {
  waNumber: WA_NUMBER,
  locale: q.currencyLocale,
  extrasPrefix: q.extrasPrefix,
  waTemplate: q.waTemplate,
  waExtras: q.waExtras,
  plans: q.plans,
};
---

<section class="quoter section" id="cotizador">
  <div class="container">
    <header class="section-head">
      <span class="section-head__eyebrow" set:html={q.eyebrowHtml} />
      <h2 class="section-head__title" set:html={q.titleHtml} />
      <p class="section-head__sub">{q.subtitle}</p>
    </header>

    <div class="quoter__card soft-card">
      <span class="quoter__blob" aria-hidden="true"></span>

      <div class="quoter__grid">
        <!-- Izquierda: objetivos + extras -->
        <div>
          <p class="quoter__step">{q.step1}</p>
          <fieldset class="quoter__goals">
            <legend class="sr-only">{q.step1}</legend>
            {q.goals.map((g) => (
              <label class="quoter__goal">
                <input type="radio" name="quoter-goal" value={g.id} class="sr-only" />
                <span class={`icon-box icon-box--md icon-box--${g.tone} quoter__goal-icon`}>
                  <span class="material-symbols-outlined" aria-hidden="true">{g.icon}</span>
                </span>
                <span>
                  <span class="quoter__goal-title">{g.title}</span>
                  <span class="quoter__goal-text">{g.text}</span>
                </span>
              </label>
            ))}
          </fieldset>

          <div class="quoter__extras" data-quoter-extras hidden>
            <p class="quoter__step">{q.step2}</p>
            <div class="quoter__extras-list" data-quoter-extras-list></div>
          </div>
        </div>

        <!-- Derecha: resultado -->
        <div class="quoter__result" aria-live="polite">
          <div class="quoter__empty" data-quoter-empty>
            <span class="material-symbols-outlined" aria-hidden="true">calculate</span>
            <p set:html={q.emptyHtml} />
          </div>

          <div class="quoter__panel" data-quoter-panel hidden>
            <p class="quoter__badge" data-q="badge"></p>
            <h3 class="quoter__name" data-q="name"></h3>
            <p class="quoter__desc" data-q="desc"></p>
            <ul class="quoter__features" data-q="features"></ul>

            <div class="quoter__total">
              <p class="quoter__total-label">{q.estimate}</p>
              <div class="quoter__total-row">
                <span class="quoter__price" data-q="price"></span>
                <span class="quoter__freq" data-q="freq"></span>
              </div>
              <p class="quoter__extras-line" data-q="extras" hidden></p>
            </div>

            <a class="quoter__wa" data-q="whatsapp" href="#" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.39.157 11.892c0 2.096.553 4.142 1.603 5.945L.057 24l6.305-1.564a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              {q.cta}
            </a>
            <p class="quoter__footnote">{q.footnote}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-quoter-data set:html={JSON.stringify(data)}></script>
</section>

<script>
  import './quoter.js';
</script>
