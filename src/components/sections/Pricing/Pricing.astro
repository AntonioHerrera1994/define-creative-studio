---
import './pricing.css';
import { TEXTURES } from '../../../data/site';
import { getLangFromUrl, useTranslations, waLink } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.pricing;
---

<section class="pricing section" id="pricing" style={`--texture: url('${TEXTURES.t4}')`}>
  <div class="container">
    <header class="section-head">
      <span class="kicker">{p.kicker}</span>
      <h2 class="section-title pricing__title" set:html={p.titleHtml} />
      <p class="section-head__sub">{p.subtitle}</p>
    </header>

    <article class="pricing__card">
      <div class="pricing__top">
        <div>
          <span class="pricing__badge">{p.badge}</span>
          <h3 class="pricing__name">{p.name}</h3>
          <p class="pricing__desc">{p.description}</p>
        </div>
        <div class="pricing__price">
          <span class="pricing__price-label">{p.priceLabel}</span>
          <span class="pricing__price-value">{p.price}</span>
          <span class="pricing__price-note">{p.priceNote}</span>
        </div>
      </div>

      <div class="pricing__body">
        <p class="pricing__intro" set:html={p.introHtml} />

        <div class="pricing__blocks">
          {p.blocks.map((b) => (
            <div class:list={['pricing__block', { 'pricing__block--wide': b.wide }]}>
              <div class="pricing__block-head">
                <div class={`icon-box icon-box--sm icon-box--${b.tone}`}>
                  <span class="material-symbols-outlined" aria-hidden="true">{b.icon}</span>
                </div>
                <h4>{b.title}</h4>
              </div>
              <p class="pricing__block-text" set:html={b.textHtml} />
              <ul class:list={['check-list', { 'check-list--2col': b.wide }]}>
                {b.items.map((it) => (
                  <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span>{it}</li>
                ))}
              </ul>
              {'note' in b && b.note && <p class="pricing__note">{b.note}</p>}
            </div>
          ))}
        </div>

        <div class="pricing__cta">
          <p>{p.ctaText}</p>
          <a href={waLink(t.wa.starter)} target="_blank" rel="noopener" class="btn btn--accent">{p.cta}</a>
        </div>
      </div>
    </article>

    <ul class="pricing__badges">
      {p.badges.map((b) => (
        <li><span class="material-symbols-outlined" aria-hidden="true">{b.icon}</span>{b.text}</li>
      ))}
    </ul>
  </div>
</section>
