---
import './services.css';
import { TEXTURES } from '../../../data/site';
import { getLangFromUrl, useTranslations, routeFor } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Tarjetas que llevan a una página dedicada (por ícono del servicio)
const pages: Record<string, string> = {
  web: routeFor('/web-design-san-diego/', lang),
};
---

<section class="services section" id="services" style={`--texture: url('${TEXTURES.t1}')`}>
  <div class="container">
    <header class="section-head">
      <span class="section-head__eyebrow" set:html={t.services.eyebrowHtml} />
      <h2 class="section-head__title">{t.services.title}</h2>
    </header>

    <div class="services__grid">
      {t.services.items.map((s) => {
        const href = pages[s.icon];
        const Tag = href ? 'a' : 'article';
        return (
          <Tag
            class={`services__card soft-card soft-card--hover services__card--${s.tone}`}
            {...(href && { href })}
          >
            <div class={`icon-box icon-box--${s.tone}`}>
              <span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>
            </div>
            <h3 class="services__title">{s.title}</h3>
            <p class="services__text">{s.text}</p>
            {href && (
              <span class="services__more">
                {t.services.more}
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
              </span>
            )}
          </Tag>
        );
      })}
    </div>
  </div>
</section>
